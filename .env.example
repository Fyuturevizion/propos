# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── AI — Cloud (GPT-4o for client-facing) ──────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── AI — Local (Ollama for internal ops) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── WhatsApp (Meta Business) ───────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
IAIN_TELEGRAM_CHAT_ID=

# ─── LINE ────────────────────────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ─── Google (Drive + Sheets sync, Calendar, Gmail) ─────────────────────────
# OAuth app with scopes: drive.readonly, spreadsheets.readonly (refresh token from Bow's account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Master inventory sheet (QUICK SERCH PROPERTY)
WNLUXE_SHEET_ID=1tL7C6X7KGcDnVSIrqrmMT0KXzxmzq0q6kgmoqaSoSPg
# Parent Drive folder containing photo subfolders named like J070, SV-006, K001
WNLUXE_DRIVE_PHOTOS_ROOT_ID=

# ─── Social Media (PostEverywhere / Ayrshare) ───────────────────────────────
SOCIAL_API_KEY=

# ─── Notion ──────────────────────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_CRM_DATABASE_ID=
NOTION_LISTINGS_DATABASE_ID=

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Brand (PropOS default; use wnluxe for The Wynn / WN Luxe) ───────────────
NEXT_PUBLIC_BRAND_ID=wnluxe
# Folder id or full https://drive.google.com/drive/folders/... URL
WNLUXE_GOOGLE_DRIVE_FOLDER_ID=
WNLUXE_GOOGLE_DRIVE_FOLDER_URL=
# Same folder id/URL for the CRM picker (client-side config endpoint)
NEXT_PUBLIC_WNLUXE_GOOGLE_DRIVE_FOLDER_ID=
NEXT_PUBLIC_WNLUXE_GOOGLE_DRIVE_FOLDER_URL=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your-cron-secret-here

# ─── Public contact (marketing) ─────────────────────────────────────────────
# Optional: only shown when set. E.164 digits for wa.me, e.g. 66812345678
NEXT_PUBLIC_WHATSAPP_E164=
# LINE / Telegram: set for WN Luxe; PropOS falls back to @ttt-properties / @TTT_Properties_Bot if unset
NEXT_PUBLIC_LINE_URL=
NEXT_PUBLIC_LINE_HANDLE=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_TELEGRAM_HANDLE=
# Public enquiries inbox (mailto + schema/llms); omit until you have a working address
NEXT_PUBLIC_CONTACT_EMAIL=
